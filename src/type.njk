---
layout: base.njk
eleventyExcludeFromCollections: true
pagination:
  data: types
  size: 1
  alias: t
permalink: "/type/{{ t.slug }}/"
eleventyComputed:
  title: "{{ t.label }}"
  description: "Haiku about {{ t.label | lower }} from {{ site.title }}."
---
<h1 class="archive-title">{{ t.label }}</h1>
<p class="lede">{{ t.haikus.length }} poem{% if t.haikus.length != 1 %}s{% endif %} about {{ t.label | lower }}.</p>
{% set current = t.slug %}
{% include "kind-nav.njk" %}
{% set list = t.haikus %}
{% include "haiku-list.njk" %}
