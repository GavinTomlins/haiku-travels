---
layout: base.njk
tags: poems
pagination:
  data: haikus
  size: 1
  alias: h
  addAllPagesToCollections: true
permalink: "/haiku/{{ h.id }}/"
eleventyComputed:
  title: "{{ h.title }}"
  date: "{{ h.date }}"
  lang: "{{ h.language }}"
  haiku: "{{ h.id }}"
  description: "{{ h.lines | join(' / ') }}"
---
{% set newer = pagination.pages[pagination.pageNumber - 1] if pagination.pageNumber > 0 else null %}
{% set older = pagination.pages[pagination.pageNumber + 1] if pagination.pageNumber + 1 < pagination.pages.length else null %}
<article class="haiku-page{% if h.status == 'draft' %} is-draft{% endif %}">
  <p class="folio"><span class="folio-site">{{ site.title }}</span><span class="folio-num">No. {{ pagination.pages.length - pagination.pageNumber }}</span></p>
  <div class="spread{% if h.images.length %} has-postcard{% endif %}">
    <div class="leaf">
      <header>
        <h1>{{ h.title }}{% if h.status == 'draft' %} <span class="badge">draft</span>{% endif %}</h1>
        <p class="meta">
          <time datetime="{{ h.date }}">{{ h.date | readableDate }}</time>
          · <a href="/type/{{ h.type }}/">{{ h.type }}</a>
          {% if h.location %}· {{ h.location.name }}{% if h.location.country %}, {{ h.location.country }}{% endif %}{% endif %}
        </p>
      </header>
      <div class="poem poem-large" lang="{{ h.language }}">{% for line in h.lines %}<span class="line">{{ line }}</span>{% endfor %}</div>
      <p class="ornament" aria-hidden="true">❦</p>
      {% if h.tags.length %}
      <p class="tags">{% for t in h.tags %}<a class="tag" href="/tag/{{ t }}/">{{ t }}</a>{% endfor %}</p>
      {% endif %}
    </div>
    {% if h.images.length %}
    <aside class="postcards">
      {% for img in h.images %}{% haikuImage img, "(min-width: 60em) 26rem, calc(100vw - 4rem)" %}{% endfor %}
    </aside>
    {% endif %}
  </div>
  <nav class="page-turn" aria-label="Previous and next poem">
    {% if newer %}<a class="turn turn-prev" href="{{ newer.url }}" rel="prev"><span class="turn-label">Newer</span><span class="turn-title">{{ newer.title }}</span></a>{% else %}<span class="turn turn-prev is-empty"></span>{% endif %}
    <a class="turn turn-index" href="/">All poems</a>
    {% if older %}<a class="turn turn-next" href="{{ older.url }}" rel="next"><span class="turn-label">Older</span><span class="turn-title">{{ older.title }}</span></a>{% else %}<span class="turn turn-next is-empty"></span>{% endif %}
  </nav>
  <footer class="attribution">
    <p>“{{ h.title }}” by {{ h.author }} is licensed under <a href="{{ site.license.url }}" rel="license">{{ site.license.short }}</a>.
    Canonical: <a href="{{ h.url | absolute }}">{{ h.url | absolute }}</a>.
    {% if h.updated %}Updated <time datetime="{{ h.updated }}">{{ h.updated | readableDate }}</time>.{% endif %}</p>
  </footer>
</article>
<script src="/js/page-turn.js" defer></script>
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "genre": "haiku",
  "headline": h.title,
  "text": h.lines | join("\n"),
  "author": { "@type": "Person", "name": h.author },
  "datePublished": h.date,
  "dateModified": h.updated or h.date,
  "inLanguage": h.language,
  "url": h.url | absolute,
  "license": site.license.url,
  "keywords": h.tags | join(", "),
  "isPartOf": { "@type": "WebSite", "name": site.title, "url": site.url }
} | jsonld | safe }}</script>
