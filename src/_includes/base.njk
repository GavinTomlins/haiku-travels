<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ (canonical or page.url) | absolute }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{{ 'article' if haiku and page.url != '/' else 'website' }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ page.url | absolute }}">
  {% set ogImg = h.images[0] | ogImage if (haiku and h.images and h.images.length) else null %}
  {% if ogImg %}
  <meta property="og:image" content="{{ ogImg.url | absolute }}">
  <meta property="og:image:width" content="{{ ogImg.width }}">
  <meta property="og:image:height" content="{{ ogImg.height }}">
  <meta property="og:image:alt" content="{{ h.images[0].alt }}">
  <meta name="twitter:card" content="summary_large_image">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="theme-color" content="#d9c9a6" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1b1712" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#7d2e1e">
  <link rel="preload" href="/fonts/eb-garamond-roman.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="license" href="{{ site.license.url }}">
  <link rel="stylesheet" href="/css/site.css?v={{ assets.css }}">
  <script src="/js/style-switch.js?v={{ assets.styleSwitch }}"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <svg width="0" height="0" class="svg-defs" aria-hidden="true" focusable="false"><filter id="deckle"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="4" seed="7"/><feDisplacementMap in="SourceGraphic" scale="9" xChannelSelector="R" yChannelSelector="G"/></filter></svg>
  <header class="site-header">
    <a class="brand" href="/">{{ site.title }}</a>
    <p class="tagline">{{ site.description }}</p>
    <nav aria-label="Main">
      <ul>
        <li><a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Latest</a></li>
        <li><a href="/archive/" {% if page.url == '/archive/' or page.url.startsWith('/type/') %}aria-current="page"{% endif %}>Archive</a></li>
        <li><a href="/tags/" {% if page.url == '/tags/' %}aria-current="page"{% endif %}>Tags</a></li>
        <li><a href="/search/" {% if page.url == '/search/' %}aria-current="page"{% endif %}>Search</a></li>
        <li><a href="/about/" {% if page.url == '/about/' %}aria-current="page"{% endif %}>About</a></li>
      </ul>
    </nav>
  </header>
  <main id="main" class="page">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>Haiku © {{ site.author }} · <a href="{{ site.license.url }}" rel="license">{{ site.license.short }}</a> · <a href="/feed.xml">Feed</a> · <a href="https://github.com/GavinTomlins/haiku-travels">Source</a> (MIT) · No cookies, no trackers</p>
    <p class="style-picker">Style: <a href="?style=a" data-set-style="a">A</a> <a href="?style=b" data-set-style="b">B</a> <a href="?style=c" data-set-style="c">C</a> <a href="?style=d" data-set-style="d">D</a></p>
  </footer>
</body>
</html>
