<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ (canonical or page.url) | absolute }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{{ 'article' if haiku else 'website' }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ page.url | absolute }}">
  <meta name="twitter:card" content="summary">
  <meta name="theme-color" content="#e8dcc2">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="license" href="{{ site.license.url }}">
  <link rel="stylesheet" href="/css/site.css?v={{ assets.css }}">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="brand" href="/">{{ site.title }}</a>
    <p class="tagline">{{ site.description }}</p>
    <nav aria-label="Main">
      <ul>
        <li><a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Latest</a></li>
        <li><a href="/archive/" {% if page.url == '/archive/' or page.url.startsWith('/type/') %}aria-current="page"{% endif %}>Archive</a></li>
        <li><a href="/tags/" {% if page.url == '/tags/' %}aria-current="page"{% endif %}>Tags</a></li>
        <li><a href="/search/" {% if page.url == '/search/' %}aria-current="page"{% endif %}>Search</a></li>
        <li><a href="/about/" {% if page.url == '/about/' %}aria-current="page"{% endif %}>About</a></li>
      </ul>
    </nav>
  </header>
  <main id="main" class="page">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>Haiku © {{ site.author }}, licensed <a href="{{ site.license.url }}" rel="license">{{ site.license.short }}</a>. <a href="/about/#licence">Commercial use and other enquiries</a>.</p>
    <p><a href="/feed.xml">Feed</a> · <a href="https://github.com/GavinTomlins/haiku-travels">Source</a></p>
  </footer>
</body>
</html>
