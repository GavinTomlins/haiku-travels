---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ "/" | absolute }}</loc></url>
  <url><loc>{{ "/about/" | absolute }}</loc></url>
  <url><loc>{{ "/archive/" | absolute }}</loc></url>
  <url><loc>{{ "/tags/" | absolute }}</loc></url>
  <url><loc>{{ "/search/" | absolute }}</loc></url>
{%- for t in types %}
  <url><loc>{{ ("/type/" + t.slug + "/") | absolute }}</loc></url>
{%- endfor %}
{%- for t in tags %}
  <url><loc>{{ ("/tag/" + t.slug + "/") | absolute }}</loc></url>
{%- endfor %}
{%- for h in haikus %}
  <url><loc>{{ h.url | absolute }}</loc><lastmod>{{ h.updated or h.date }}</lastmod></url>
{%- endfor %}
</urlset>
